# Copy to .env and fill in what you use. .env is gitignored; never commit real keys.

# HuggingFace token (Gemma-2-2B is gated).
HUGGING_FACE_API_KEY=

# LLM judges llama70b / gpt-oss-120b: any OpenAI-compatible endpoint serving those models.
JUDGE_BASE_URL=
JUDGE_API_KEY=

# LLM Sel baseline (gpt-oss-120b). Leave LLMSEL_URL empty when
# scripts/circuit_compress_eval.sh self-hosts it (LLMSEL_SELFHOST=true).
LLMSEL_URL=
LLMSEL_API_KEY=

# OpenAI public API (gpt5-* judges, gpt-4o-mini feature captions).
OPENAI_API_KEY=
